# 复制为项目根目录 .env 后按需修改；Docker Compose 会读取同名变量。
APP_USERNAME=admin
APP_PASSWORD=admin123

# 数据目录与 SQLite 文件（默认 backend/data；从 backend/ 启动时可用相对路径）
# BAJIU_DATA_DIR=./data
# BAJIU_DB_PATH=./data/bajiu.db

# 服务监听（本地单用户默认仅 127.0.0.1）
BAJIU_HOST=127.0.0.1
BAJIU_PORT=8000
BAJIU_TOKEN_TTL_MINUTES=10080

# 前端开发服务器来源（逗号分隔）
BAJIU_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 可选：GitHub 采集 token，避免 API 限流
GITHUB_TOKEN=

# GitHub 采集 TLS 校验方式：
#   certifi（默认，内置 CA）| system（操作系统根证书；本机走 TLS 代理/抓包工具时用它）
#   | none（不校验，仅排障，存在中间人风险）
# BAJIU_GITHUB_SSL=system

# M3a AI（OpenAI 兼容接口）。三项留空即关闭 AI，核心功能与人工质检不受影响。
# base_url 示例：https://api.deepseek.com/v1 或 https://dashscope.aliyuncs.com/compatible-mode/v1
BAJIU_AI_BASE_URL=
BAJIU_AI_API_KEY=
BAJIU_AI_MODEL=
# 可选参数（括号内为默认值）
# BAJIU_AI_TIMEOUT_SEC=60
# BAJIU_AI_MAX_INPUT_CHARS=8000
# BAJIU_AI_MAX_OUTPUT_TOKENS=2000
# BAJIU_AI_MONTHLY_TOKEN_LIMIT=1000000
# BAJIU_AI_CACHE_TTL_DAYS=30
# BAJIU_AI_JSON_MODE=auto        # auto / on / off
# BAJIU_AI_SSL=certifi           # certifi / system / none
# 费用估算单价（每 1K tokens，币种随供应商；默认 0 表示只记录 tokens 不估算费用）
# BAJIU_AI_PRICE_INPUT_PER_1K=0
# BAJIU_AI_PRICE_OUTPUT_PER_1K=0
